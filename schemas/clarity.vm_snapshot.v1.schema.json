{
  "schema": "clarity.vm_snapshot.v1",
  "type": "object",
  "required": ["schema", "snapshot_id", "profile_id", "profile_hash", "created_at_utc", "checkpoint_type", "state", "available", "verification_scope", "guest_image_ref", "configuration_hash", "disk_hashes"],
  "properties": {
    "schema": { "const": "clarity.vm_snapshot.v1" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_hash": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "checkpoint_type": { "type": "string", "minLength": 1 },
    "state": { "enum": ["offline", "saved", "running", "unknown"] },
    "available": { "type": "boolean" },
    "verification_scope": { "enum": ["manifest_only", "content_verified"] },
    "guest_image_ref": { "type": "string", "minLength": 1 },
    "configuration_hash": { "type": "string", "minLength": 1 },
    "disk_hashes": { "type": "array", "minItems": 1 }
  }
}
