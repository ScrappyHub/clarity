{
  "schema": "clarity.hyperv_lifecycle.v1",
  "type": "object",
  "required": ["schema", "run_id", "created_at_utc", "assurance", "status", "reason_codes", "host_probe", "phases"],
  "properties": {
    "schema": { "const": "clarity.hyperv_lifecycle.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "assurance": { "const": "A1_HOST_OBSERVED" },
    "status": { "enum": ["refused", "deferred", "completed", "failed"] },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "profile_decision": { "type": ["string", "null"] },
    "host_probe": { "type": "object" },
    "vm_name": { "type": ["string", "null"] },
    "readback": { "type": ["object", "null"] },
    "config_checks": { "type": "array" },
    "boot": { "type": "object" },
    "teardown": { "type": "object" },
    "host_contamination": { "type": "object" },
    "phases": { "type": "array" }
  }
}
