{
  "schema": "clarity.baseline.v1",
  "type": "object",
  "required": ["schema", "baseline_id", "version", "entries"],
  "properties": {
    "schema": { "const": "clarity.baseline.v1" },
    "baseline_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "required": { "type": "boolean" },
          "signer": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
