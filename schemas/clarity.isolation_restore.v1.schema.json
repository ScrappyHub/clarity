    "producer_instance": { "type": "string" },
    "object_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "destination_path": { "type": "string", "minLength": 1 },
    "restored_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorized": { "type": "boolean" },
    "decision": { "enum": ["restored", "restored_idempotent"] },
