    "run_id": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "validator": { "const": "clarity" },
    "mode": { "type": "string" },
    "assurance_level": { "enum": ["A0_UNAVAILABLE", "A1_HOST_OBSERVED", "A2_ISOLATED_REVIEW", "A3_MEASURED_PLATFORM", "A4_ATTESTED_PLATFORM"] },
    "tenant": { "type": "string" },
    "principal": { "type": "string" },
    "producer_instance": { "type": "string" },
    "trust_tier": { "enum": ["FULL", "DEGRADED", "FAIL"] },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "device": { "type": "object" },
    "capabilities": { "type": "object" },
    "runtime": { "type": "object" },
    "build_hashes": { "type": "object" },
    "missing_required_scripts": { "type": "array", "items": { "type": "string" } }
  }
}
