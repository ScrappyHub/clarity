param(
  [Parameter(Mandatory=$true)][ValidateNotNullOrEmpty()][string]$ArtifactDir
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

function Fail([string]$msg) {
  Write-Host $msg -ForegroundColor Red
  exit 2
}

try {
  if (-not (Test-Path -LiteralPath $ArtifactDir)) {
    Fail "FAIL: artifact dir missing: $ArtifactDir"
  }

  # Hard rule: transient must not exist
  $transient = Join-Path $ArtifactDir "sha256sums.txt.sig"
  if (Test-Path -LiteralPath $transient) {
    Fail "FAIL: transient sha256sums.txt.sig still present"
  }

  # Canonical set must exist
  foreach ($f in @("sha256sums.txt","signature.ed25519","signature.json","pubkey_ed25519.pem")) {
    if (-not (Test-Path -LiteralPath (Join-Path $ArtifactDir $f))) {
      Fail ("FAIL: missing {0}" -f $f)
    }
  }

  # sha256sums must include signature.ed25519 (CRLF-safe)
  $sumsPath = Join-Path $ArtifactDir "sha256sums.txt"
  $sums = (Get-Content -Raw -LiteralPath $sumsPath) -replace "`r",""
  if ($sums -notmatch '(?m)\s+signature\.ed25519$') {
    Fail "FAIL: sha256sums.txt missing signature.ed25519 entry"
  }

  # refused.json mode must be v1_4f (if present)
  $refusedPath = Join-Path $ArtifactDir "refused.json"
  if (Test-Path -LiteralPath $refusedPath) {
    $rj = Get-Content -Raw -LiteralPath $refusedPath
    if ($rj -notmatch '"mode"\s*:\s*"windows_userland_v1_4f"') {
      Fail "FAIL: refused.json mode not windows_userland_v1_4f"
    }
  }

  Write-Host "PASS: Option B + hygiene + REFUSE_SCAN mode" -ForegroundColor Green
  exit 0
}
catch {
  Write-Host ("BUG: {0}" -f $_.Exception.Message) -ForegroundColor Red
  exit 1
}
