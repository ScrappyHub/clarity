param(
  [Parameter(Mandatory=$true)]
  [ValidateNotNullOrEmpty()]
  [string]$ArtifactDir,

  # Prefer signature.json tool_path if present; else fall back to PATH
  [Parameter(Mandatory=$false)]
  [string]$SshKeygenPath = "",

  # IMPORTANT: ssh-keygen signatures are namespaced; default to "clarity"
  [Parameter(Mandatory=$false)]
  [string]$SigNamespace = "clarity",

  # Identity/principal used for allowed_signers; default extracted from pubkey comment if possible
  [Parameter(Mandatory=$false)]
  [string]$SigIdentity = ""
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

function Fail([int]$code, [string]$msg) {
  Write-Host $msg -ForegroundColor Red
  exit $code
}

function Get-Sha256Hex([string]$path) {
  (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant()
}

function Resolve-SshKeygenExe([string]$explicitPath, [string]$artifactDir) {
  if ($explicitPath -and $explicitPath.Trim() -ne "") {
    if (-not (Test-Path -LiteralPath $explicitPath)) { Fail 4 ("FAIL: SshKeygenPath not found: {0}" -f $explicitPath) }
    return $explicitPath
  }

  # Try reading signature.json tool_path (deterministic)
  $sj = Join-Path $artifactDir "signature.json"
  if (Test-Path -LiteralPath $sj) {
    try {
      $j = Get-Content -Raw -LiteralPath $sj -Encoding UTF8 | ConvertFrom-Json
      if ($j.tool_path -and (Test-Path -LiteralPath $j.tool_path)) {
        return [string]$j.tool_path
      }
    } catch { }
  }

  $cmd = Get-Command ssh-keygen.exe -ErrorAction SilentlyContinue
  if ($cmd) { return $cmd.Source }

  # common locations
  $candidates = @(
    "C:\Windows\System32\OpenSSH\ssh-keygen.exe",
    "$env:ProgramFiles\OpenSSH-Win64\ssh-keygen.exe",
    "$env:ProgramFiles\Git\usr\bin\ssh-keygen.exe"
  )
  $found = $candidates | Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1
  if ($found) { return $found }

  Fail 4 "FAIL: ssh-keygen.exe not found (cannot verify SSH signature). Provide -SshKeygenPath."
}

function Get-OpenSshPubkeyLine([string]$pubPath) {
  $line = (Get-Content -LiteralPath $pubPath -TotalCount 1 -ErrorAction Stop).Trim()
  if ($line -notmatch '^\s*ssh-ed25519\s+') {
    Fail 4 "FAIL: pubkey_ed25519.pem is not OpenSSH 'ssh-ed25519 ...' format (expected for ssh-keygen verify)."
  }
  return $line
}

function Get-DefaultIdentityFromPubkey([string]$sshLine) {
  # ssh-ed25519 <b64> <comment>
  $parts = $sshLine -split '\s+'
  if ($parts.Length -ge 3) { return $parts[2] }
  return "clarity"
}

try {
  if (-not (Test-Path -LiteralPath $ArtifactDir)) {
    Fail 2 "FAIL: artifact dir missing: $ArtifactDir"
  }

  # Hard rule: transient must not exist
  $transient = Join-Path $ArtifactDir "sha256sums.txt.sig"
  if (Test-Path -LiteralPath $transient) {
    Fail 2 "FAIL: transient sha256sums.txt.sig still present"
  }

  # Canonical set must exist
  $required = @("sha256sums.txt","signature.ed25519","signature.json","pubkey_ed25519.pem")
  foreach ($f in $required) {
    $p = Join-Path $ArtifactDir $f
    if (-not (Test-Path -LiteralPath $p)) { Fail 2 ("FAIL: missing {0}" -f $f) }
  }

  # refused.json mode must be windows_userland_v1_4f (if present)
  $refusedPath = Join-Path $ArtifactDir "refused.json"
  if (Test-Path -LiteralPath $refusedPath) {
    $rj = Get-Content -Raw -LiteralPath $refusedPath -Encoding UTF8
    if ($rj -notmatch '"mode"\s*:\s*"windows_userland_v1_4f"') {
      Fail 5 "FAIL: refused.json mode not windows_userland_v1_4f"
    }
  }

  # Parse sha256sums.txt (CRLF-safe)
  $sumsPath = Join-Path $ArtifactDir "sha256sums.txt"
  $rawSums = (Get-Content -Raw -LiteralPath $sumsPath -Encoding UTF8) -replace "`r",""
  $lines = ($rawSums -split "`n") | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne "" }

  if (-not $lines -or $lines.Count -lt 1) { Fail 3 "FAIL: sha256sums.txt empty" }

  $entries = New-Object System.Collections.Generic.List[object]
  foreach ($ln in $lines) {
    if ($ln -match '^\s*#') { continue }
    $m = [regex]::Match($ln, '^(?<hash>[0-9a-fA-F]{64})\s+(?<file>.+)$')
    if (-not $m.Success) { Fail 3 ("FAIL: malformed sha256sums line: {0}" -f $ln) }

    $h = $m.Groups['hash'].Value.ToLowerInvariant()
    $f = $m.Groups['file'].Value.Trim()
    if ($f.StartsWith("*")) { $f = $f.Substring(1).Trim() }

    $entries.Add([pscustomobject]@{ Hash=$h; File=$f }) | Out-Null
  }

  # Verify each listed file exists + hash matches
  foreach ($e in $entries) {
    # self-referential: sha list may include signature.ed25519, but signature signs sums file; allow it without hashing
    if ($e.File -eq "signature.ed25519") { continue }

    $fp = Join-Path $ArtifactDir $e.File
    if (-not (Test-Path -LiteralPath $fp)) {
      Fail 2 ("FAIL: sha256sums references missing file: {0}" -f $e.File)
    }

    $actual = Get-Sha256Hex $fp
    if ($actual -ne $e.Hash) {
      Fail 3 ("FAIL: sha256 mismatch: {0}`n  expected: {1}`n  actual:   {2}" -f $e.File, $e.Hash, $actual)
    }
  }

  # SSH signature verify (backend: sshkeygen)
  $sshKeygenExe = Resolve-SshKeygenExe $SshKeygenPath $ArtifactDir

  $pubPath = Join-Path $ArtifactDir "pubkey_ed25519.pem"
  $pubLine = Get-OpenSshPubkeyLine $pubPath

  if (-not $SigIdentity -or $SigIdentity.Trim() -eq "") {
    $SigIdentity = Get-DefaultIdentityFromPubkey $pubLine
  }

  $sigPath = Join-Path $ArtifactDir "signature.ed25519"

  # allowed_signers format: principals namespaces key
  # We'll allow any namespace via '*' in allowed_signers, but ssh-keygen verify still requires -n <namespace>.
  $allowed = Join-Path $env:TEMP ("clarity_allowed_signers_{0}.txt" -f ([Guid]::NewGuid().ToString("N")))
  Set-Content -LiteralPath $allowed -Value ("{0} * {1}" -f $SigIdentity, $pubLine) -Encoding ASCII
  $errPath = Join-Path $env:TEMP ("clarity_ssh_verify_err_{0}.txt" -f ([Guid]::NewGuid().ToString("N")))

  # Feed sha256sums.txt via stdin to avoid path quirks.
  $p = Start-Process -FilePath $sshKeygenExe -ArgumentList @(
    "-Y","verify",
    "-f",$allowed,
    "-I",$SigIdentity,
    "-n",$SigNamespace,
    "-s",$sigPath
  ) -NoNewWindow -PassThru -Wait -RedirectStandardInput $sumsPath -RedirectStandardError $errPath

    $errText = ""
  if (Test-Path -LiteralPath $errPath) {
    $errText = (Get-Content -Raw -LiteralPath $errPath -ErrorAction SilentlyContinue)
    Remove-Item -LiteralPath $errPath -Force -ErrorAction SilentlyContinue
  }

  Remove-Item -LiteralPath $allowed -Force -ErrorAction SilentlyContinue

  if ($p.ExitCode -ne 0) {
    if ($errText -and $errText.Trim() -ne "") {
      Fail 4 ("FAIL: ssh-keygen signature verification failed (exit {0}). stderr:`n{1}" -f $p.ExitCode, $errText.Trim())
    }
    Fail 4 ("FAIL: ssh-keygen signature verification failed (exit {0})." -f $p.ExitCode)
  }Write-Host "PASS: artifact hashes + ssh-keygen signature + policy ok" -ForegroundColor Green
  exit 0
}
catch {
  Write-Host ("BUG: {0}" -f $_.Exception.Message) -ForegroundColor Red
  exit 1
}

