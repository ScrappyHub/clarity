$vp = @()
$vp += 'param('
$vp += '  [Parameter(Mandatory=$true)][string]$PacketRoot,'
$vp += '  [Parameter(Mandatory=$true)][string]$RuntimeRoot,'
$vp += '  [Parameter(Mandatory=$true)][string]$Principal'
$vp += ')'
$vp += 'Set-StrictMode -Version Latest'
$vp += '$ErrorActionPreference="Stop"'
$vp += '. "$PSScriptRoot\lib\canon.ps1"'
$vp += 'function FileSha([string]$p){ Sha256HexFile $p }'
$vp += '$Allowed = Join-Path $RuntimeRoot "keys\allowed_signers"'
$vp += 'if(-not(Test-Path -LiteralPath $Allowed -PathType Leaf)){ throw ("Missing allowed_signers: " + $Allowed) }'
$vp += ''
$vp += '# PacketId = SHA256(canonical(manifest.json)) (Option A)'
$vp += '$manPath = Join-Path $PacketRoot "manifest.json"'
$vp += 'if(-not(Test-Path -LiteralPath $manPath -PathType Leaf)){ throw "Missing manifest.json" }'
$vp += '$raw = [System.Text.Encoding]::UTF8.GetString([IO.File]::ReadAllBytes($manPath))'
$vp += '$canon = CanonJson $raw'
$vp += '$packetId = Sha256Hex ((Utf8NoBom).GetBytes($canon))'
$vp += '$folderId = Split-Path -Leaf $PacketRoot'
$vp += 'if($folderId -ne $packetId){ throw ("PACKET_ID_MISMATCH folder=" + $folderId + " computed=" + $packetId) }'
$vp += '$pidPath = Join-Path $PacketRoot "packet_id.txt"'
$vp += 'if(-not(Test-Path -LiteralPath $pidPath -PathType Leaf)){ throw "Missing packet_id.txt" }'
$vp += '$pid = (Get-Content -Raw -LiteralPath $pidPath -Encoding UTF8).Trim()'
$vp += 'if($pid -ne $packetId){ throw "packet_id.txt mismatch" }'
$vp += ''
$vp += '# sha256sums verify (no mutation)'
$vp += '$shaPath = Join-Path $PacketRoot "sha256sums.txt"'
$vp += 'if(-not(Test-Path -LiteralPath $shaPath -PathType Leaf)){ throw "Missing sha256sums.txt" }'
$vp += '$lines = Get-Content -LiteralPath $shaPath -Encoding UTF8'
$vp += 'foreach($ln in $lines){'
$vp += '  if($ln.Trim() -eq ""){ continue }'
$vp += '  $parts = $ln -split "\s{2,}"'
$vp += '  if(@($parts).Count -lt 2){ throw ("Bad sha256sums line: " + $ln) }'
$vp += '  $h = $parts[0].Trim()'
$vp += '  $rel = $parts[1].Trim()'
$vp += '  $p = Join-Path $PacketRoot ($rel -replace "/","\")'
$vp += '  if(-not(Test-Path -LiteralPath $p -PathType Leaf)){ throw ("Missing file in packet: " + $rel) }'
$vp += '  $hh = FileSha $p'
$vp += '  if($hh -ne $h){ throw ("SHA256_MISMATCH: " + $rel) }'
$vp += '}'
$vp += ''
$vp += '# commit hash verify'
$vp += '$commitPath = Join-Path $PacketRoot "payload\commit.payload.json"'
$vp += '$commitRaw = [System.Text.Encoding]::UTF8.GetString([IO.File]::ReadAllBytes($commitPath))'
$vp += '$commitCanon = CanonJson $commitRaw'
$vp += '$commitHash = Sha256Hex ((Utf8NoBom).GetBytes($commitCanon))'
$vp += '$expected = (Get-Content -Raw -LiteralPath (Join-Path $PacketRoot "payload\commit_hash.txt") -Encoding UTF8).Trim()'
$vp += 'if($commitHash -ne $expected){ throw "COMMIT_HASH_MISMATCH" }'
$vp += ''
$vp += '# signature verify over msg = commit_hash + packet_id + ingest_hash'
$vp += '$ingPath = Join-Path $PacketRoot "payload\nfl.ingest.json"'
$vp += '$ingRaw = [System.Text.Encoding]::UTF8.GetString([IO.File]::ReadAllBytes($ingPath))'
$vp += '$ingCanon = CanonJson $ingRaw'
$vp += '$ingHash = Sha256Hex ((Utf8NoBom).GetBytes($ingCanon))'
$vp += '$msg = Join-Path $env:TEMP ("clarity_verifymsg_" + [Guid]::NewGuid().ToString("N") + ".txt")'
$vp += 'WriteUtf8Lf $msg (($commitHash + "`n" + $packetId + "`n" + $ingHash + "`n"))'
$vp += '$sig = Join-Path $PacketRoot "signatures\ingest.sig"'
$vp += 'if(-not(Test-Path -LiteralPath $sig -PathType Leaf)){ throw "Missing signatures/ingest.sig" }'
$vp += '& ssh-keygen.exe -Y verify -n "nfl.ingest.v1" -I $Principal -f $Allowed -s $sig -o $msg | Out-Null'
$vp += 'Remove-Item -LiteralPath $msg -Force -ErrorAction SilentlyContinue'
$vp += 'Write-Host ("VERIFY OK (Option A): " + $PacketRoot) -ForegroundColor Green'

