$canon += ''
$canon += 'function EnsureDir([string]$p){ if(-not (Test-Path -LiteralPath $p -PathType Container)){ New-Item -ItemType Directory -Force -Path $p | Out-Null } }'
$canon += 'function Utf8NoBom(){ New-Object System.Text.UTF8Encoding($false) }'
$canon += 'function WriteUtf8Lf([string]$path,[string]$text){ $dir=Split-Path -Parent $path; if($dir){ EnsureDir $dir }; $t=$text.Replace("`r`n","`n").Replace("`r","`n"); if(-not $t.EndsWith("`n")){ $t += "`n" }; [IO.File]::WriteAllBytes($path,(Utf8NoBom).GetBytes($t)) }'
$canon += 'function ReadAllBytes([string]$p){ [IO.File]::ReadAllBytes($p) }'
$canon += 'function Sha256Hex([byte[]]$bytes){ if($null -eq $bytes){ $bytes=[byte[]]@() }; $sha=[Security.Cryptography.SHA256]::Create(); ($sha.ComputeHash([byte[]]$bytes) | ForEach-Object { $_.ToString("x2") }) -join "" }'
$canon += 'function Sha256HexFile([string]$p){ Sha256Hex (ReadAllBytes $p) }'
$canon += ''
$canon += '# Canonical JSON v1: recurse-sort object keys; arrays preserve order; minified'
$canon += 'function ConvertTo-OrderedJsonNode([System.Text.Json.Nodes.JsonNode]$n){'
$canon += '  if($null -eq $n){ return $null }'
$canon += '  if($n -is [System.Text.Json.Nodes.JsonObject]){'
$canon += '    $o=[System.Text.Json.Nodes.JsonObject]::new()'
$canon += '    $names=@()'
$canon += '    foreach($kv in $n.GetEnumerator()){ $names += $kv.Key }'
$canon += '    foreach($name in ($names | Sort-Object)){ $o[$name] = (ConvertTo-OrderedJsonNode $n[$name]) }'
$canon += '    return $o'
$canon += '  }'
$canon += '  if($n -is [System.Text.Json.Nodes.JsonArray]){'
$canon += '    $a=[System.Text.Json.Nodes.JsonArray]::new()'
$canon += '    foreach($it in $n){ [void]$a.Add((ConvertTo-OrderedJsonNode $it)) }'
$canon += '    return $a'
$canon += '  }'
$canon += '  return $n'
$canon += '}'
$canon += 'function CanonJson([string]$json){ $node=[System.Text.Json.Nodes.JsonNode]::Parse($json); $ord=ConvertTo-OrderedJsonNode $node; $opt=[System.Text.Json.JsonSerializerOptions]::new(); $opt.WriteIndented=$false; return $ord.ToJsonString($opt) }'

