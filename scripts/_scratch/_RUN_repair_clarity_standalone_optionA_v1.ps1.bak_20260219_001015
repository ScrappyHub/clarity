$mk += '    (Join-Path $root "payload\commit.payload.json"),'
$mk += '    (Join-Path $root "payload\commit_hash.txt"),'
$mk += '    (Join-Path $root "payload\nfl.ingest.json")'
$mk += '  )'
$mk += '  $arr=[System.Text.Json.Nodes.JsonArray]::new()'
