$mk += '  $m["producer"]="clarity"'
$mk += '  $m["producer_instance"]=$ProducerInstance'
$mk += '  $m["created_at_utc"]=$createdAt'
$mk += '  $m["files"]=$arr'
$mk += '  return $m'
$mk += '}'
