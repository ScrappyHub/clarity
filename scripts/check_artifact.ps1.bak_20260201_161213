param(
  [Parameter(Mandatory=$true)]
  [ValidateNotNullOrEmpty()]
  [string]$ArtifactDir,

  [Parameter(Mandatory=$false)]
  [string]$OpenSslPath = "",

  [Parameter(Mandatory=$false)]
  [string]$SshKeygenPath = ""
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

function Fail([int]$code, [string]$msg) {
  Write-Host $msg -ForegroundColor Red
  exit $code
}

function Get-Sha256Hex([string]$path) {
  (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant()
}

function Resolve-OpenSslExe([string]$explicitPath) {
  if ($explicitPath -and $explicitPath.Trim() -ne "") {
    if (-not (Test-Path -LiteralPath $explicitPath)) { Fail 4 ("FAIL: OpenSslPath not found: {0}" -f $explicitPath) }
    return $explicitPath
  }
  $cmd = Get-Command openssl.exe -ErrorAction SilentlyContinue
  if ($cmd) { return $cmd.Source }
  Fail 4 "FAIL: openssl.exe not found in PATH. Provide -OpenSslPath."
}

function Resolve-SshKeygenExe([string]$explicitPath) {
  if ($explicitPath -and $explicitPath.Trim() -ne "") {
    if (-not (Test-Path -LiteralPath $explicitPath)) { Fail 4 ("FAIL: SshKeygenPath not found: {0}" -f $explicitPath) }
    return $explicitPath
  }
  $cmd = Get-Command ssh-keygen.exe -ErrorAction SilentlyContinue
  if ($cmd) { return $cmd.Source }

  # common Git for Windows locations
  $candidates = @(
    "$env:ProgramFiles\Git\usr\bin\ssh-keygen.exe",
    "$env:ProgramFiles\Git\bin\ssh-keygen.exe",
    "$env:LocalAppData\Programs\Git\usr\bin\ssh-keygen.exe"
  )
  $found = $candidates | Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1
  if ($found) { return $found }

  return $null
}

function Get-PubKeyPemPath([string]$pubPath) {
  # If it's already PEM, use it. If it's OpenSSH ("ssh-ed25519 ..."), convert to PEM via ssh-keygen.
  $first = (Get-Content -LiteralPath $pubPath -TotalCount 1 -ErrorAction Stop)
  if ($first -match '^\s*-----BEGIN PUBLIC KEY-----') {
    return $pubPath
  }

  if ($first -match '^\s*ssh-ed25519\s+') {
    $sshKeygen = Resolve-SshKeygenExe $SshKeygenPath
    if (-not $sshKeygen) {
      Fail 4 "FAIL: pubkey_ed25519.pem is OpenSSH format (ssh-ed25519 ...) but ssh-keygen.exe not found. Install OpenSSH or Git, or store PEM public key instead."
    }

    $tmpPem = Join-Path $env:TEMP ("clarity_pubkey_{0}.pem" -f ([Guid]::NewGuid().ToString("N")))
    # ssh-keygen can output OpenSSH key in PEM (-m PEM). It reads public key via -f.
    $p = Start-Process -FilePath $sshKeygen -ArgumentList @(
      "-e",            # export
      "-m","PEM",      # PEM output
      "-f",$pubPath
    ) -NoNewWindow -PassThru -Wait -RedirectStandardOutput $tmpPem -RedirectStandardError (Join-Path $env:TEMP ("clarity_sshkeygen_err_{0}.txt" -f ([Guid]::NewGuid().ToString("N"))))

    if ($p.ExitCode -ne 0) {
      Fail 4 ("FAIL: ssh-keygen export to PEM failed (exit {0})" -f $p.ExitCode)
    }

    # sanity: ensure PEM header exists
    $h = (Get-Content -LiteralPath $tmpPem -TotalCount 1 -ErrorAction Stop)
    if ($h -notmatch '^\s*-----BEGIN PUBLIC KEY-----') {
      Fail 4 "FAIL: ssh-keygen produced non-PEM output (unexpected)."
    }

    return $tmpPem
  }

  Fail 4 "FAIL: pubkey_ed25519.pem is neither PEM nor OpenSSH ssh-ed25519 format."
  return $null
}

try {
  if (-not (Test-Path -LiteralPath $ArtifactDir)) {
    Fail 2 "FAIL: artifact dir missing: $ArtifactDir"
  }

  # Hard rule: transient must not exist
  $transient = Join-Path $ArtifactDir "sha256sums.txt.sig"
  if (Test-Path -LiteralPath $transient) {
    Fail 2 "FAIL: transient sha256sums.txt.sig still present"
  }

  # Canonical set must exist
  $required = @("sha256sums.txt","signature.ed25519","signature.json","pubkey_ed25519.pem")
  foreach ($f in $required) {
    $p = Join-Path $ArtifactDir $f
    if (-not (Test-Path -LiteralPath $p)) { Fail 2 ("FAIL: missing {0}" -f $f) }
  }

  # refused.json mode must be windows_userland_v1_4f (if present)
  $refusedPath = Join-Path $ArtifactDir "refused.json"
  if (Test-Path -LiteralPath $refusedPath) {
    $rj = Get-Content -Raw -LiteralPath $refusedPath -Encoding UTF8
    if ($rj -notmatch '"mode"\s*:\s*"windows_userland_v1_4f"') {
      Fail 5 "FAIL: refused.json mode not windows_userland_v1_4f"
    }
  }

  # Parse sha256sums.txt (CRLF-safe)
  $sumsPath = Join-Path $ArtifactDir "sha256sums.txt"
  $rawSums = (Get-Content -Raw -LiteralPath $sumsPath -Encoding UTF8) -replace "`r",""
  $lines = ($rawSums -split "`n") | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne "" }

  if (-not $lines -or $lines.Count -lt 1) { Fail 3 "FAIL: sha256sums.txt empty" }

  $entries = New-Object System.Collections.Generic.List[object]
  foreach ($ln in $lines) {
    if ($ln -match '^\s*#') { continue }
    $m = [regex]::Match($ln, '^(?<hash>[0-9a-fA-F]{64})\s+(?<file>.+)$')
    if (-not $m.Success) { Fail 3 ("FAIL: malformed sha256sums line: {0}" -f $ln) }

    $h = $m.Groups['hash'].Value.ToLowerInvariant()
    $f = $m.Groups['file'].Value.Trim()
    if ($f.StartsWith("*")) { $f = $f.Substring(1).Trim() }

    $entries.Add([pscustomobject]@{ Hash=$h; File=$f }) | Out-Null
  }

  # Verify each listed file exists + hash matches
  foreach ($e in $entries) {
    # self-referential: sha list may include signature.ed25519, but signature signs sums file; allow it without hashing
    if ($e.File -eq "signature.ed25519") { continue }

    $fp = Join-Path $ArtifactDir $e.File
    if (-not (Test-Path -LiteralPath $fp)) {
      Fail 2 ("FAIL: sha256sums references missing file: {0}" -f $e.File)
    }

    $actual = Get-Sha256Hex $fp
    if ($actual -ne $e.Hash) {
      Fail 3 ("FAIL: sha256 mismatch: {0}`n  expected: {1}`n  actual:   {2}" -f $e.File, $e.Hash, $actual)
    }
  }

  # Verify Ed25519 signature over sha256sums.txt
  $opensslExe = Resolve-OpenSslExe $OpenSslPath

  $pubRaw = Join-Path $ArtifactDir "pubkey_ed25519.pem"
  $pubPem = Get-PubKeyPemPath $pubRaw
  $sig = Join-Path $ArtifactDir "signature.ed25519"

  # verify signature
  $p = Start-Process -FilePath $opensslExe -ArgumentList @(
    "pkeyutl","-verify",
    "-pubin","-inkey",$pubPem,
    "-sigfile",$sig,
    "-in",$sumsPath
  ) -NoNewWindow -PassThru -Wait

  # cleanup temp pem if we created one
  if ($pubPem -ne $pubRaw -and (Test-Path -LiteralPath $pubPem)) {
    Remove-Item -LiteralPath $pubPem -Force -ErrorAction SilentlyContinue
  }

  if ($p.ExitCode -ne 0) {
    Fail 4 ("FAIL: signature verification failed (openssl exit {0})" -f $p.ExitCode)
  }

  Write-Host "PASS: artifact hashes + signature + policy ok" -ForegroundColor Green
  exit 0
}
catch {
  Write-Host ("BUG: {0}" -f $_.Exception.Message) -ForegroundColor Red
  exit 1
}
