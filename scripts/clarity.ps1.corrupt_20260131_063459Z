              block_action = $blockAction
              block_detail = $blockDetail
            })
          } else {
            $verified.Add([ordered]@{ path=$fi.FullName; size=$fi.Length })
          }
        }
    }

    $report = [ordered]@{
      clarity = "Clarity Validator"
      run_id = $runId
      issued_at_utc = (Get-Date).ToUniversalTime().ToString("o")
      mode = $mode
      target_root = $TargetRoot
      policy = [ordered]@{
        quarantine_mode = $QuarantineMode
        block_method = $BlockMethod
        safe_by_default = $true
        note = "Default is CopyOnly (no original modification). Blocking is optional and refused on critical paths."
      }
      scan = [ordered]@{
        full_scan = [bool]$FullScan
        targets = $targets
        enumerated_files = $fileCount
        verified_count = $verified.Count
        compromised_count = $findings.Count
        isolated_count = $findings.Count
        max_findings = $MaxFindings
      }
      boot_verification = $bootVerification
      isolation_vault = [ordered]@{
        vault_dir = $vaultDir
        mode = "copy_to_vault"
      }
      handoff = [ordered]@{
        allowed = $true
        allowed_mode = $(if($findings.Count -gt 0){"restricted"}else{"normal"})
        note = "v1.1 userland cannot gate boot; canonical contract retained for pre-OS integration"
      }
    }

    Write-Text (Join-Path $artifactDir "report.json") (Json $report)

    $vCsv = Join-Path $artifactDir "files_verified.csv"
    $cCsv = Join-Path $artifactDir "files_compromised.csv"

    "path,size" | Set-Content -LiteralPath $vCsv -Encoding UTF8
    foreach ($v in $verified) {
      Add-Content -LiteralPath $vCsv -Value ('"{0}",{1}' -f ($v.path -replace '"','""'), $v.size) -Encoding UTF8
    }

    "path,sha256,reason,vault_path,quarantine_mode,block_method,block_action,block_detail" | Set-Content -LiteralPath $cCsv -Encoding UTF8
    foreach ($f in $findings) {
      Add-Content -LiteralPath $cCsv -Value ('"{0}","{1}","{2}","{3}","{4}","{5}","{6}","{7}"' -f `
        ($f.path -replace '"','""'), $f.sha256, $f.reason, ($f.vault_path -replace '"','""'), $f.quarantine_mode, $f.block_method, $f.block_action, ($f.block_detail -replace '"','""')) -Encoding UTF8
    }

    Write-Sha256Sums $artifactDir @("report.json","files_verified.csv","files_compromised.csv")

    Write-Host ""
    Write-Host "CLARITY RESULT" -ForegroundColor Cyan
    Write-Host ("  VERIFIED:     {0}" -f $verified.Count) -ForegroundColor Green
    Write-Host ("  COMPROMISED:  {0}" -f $findings.Count) -ForegroundColor Yellow
    Write-Host ("  QUARANTINE:   {0} (safe-by-default)" -f $QuarantineMode) -ForegroundColor Gray
    if ($findings.Count -gt 0) {
      Write-Host ("  ISOLATION VAULT: {0}" -f $vaultDir) -ForegroundColor Yellow
      Write-Host ("  ARTIFACT: {0}" -f $artifactDir) -ForegroundColor Gray
      Write-Host "  Next: open files_compromised.csv for paths + reasons + block_action." -ForegroundColor Yellow
    } else {
      Write-Host ("  ARTIFACT: {0}" -f $artifactDir) -ForegroundColor Gray
    }
    break
  }

  default { throw "Unknown command: $Command" }
}

