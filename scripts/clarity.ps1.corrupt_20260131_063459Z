switch ($Command) {
  "status" {
    $disabled = Get-IsDisabled
    Write-Host ("CLARITY status: {0}" -f ($(if($disabled){"DISABLED"}else{"ENABLED"}))) -ForegroundColor Cyan
    if ($disabled) {
      $st = Get-Content -Raw -LiteralPath (Get-DisableStatePath) | ConvertFrom-Json
      Write-Host ("Disabled until (UTC): {0}" -f $st.disabled_until_utc)
      Write-Host ("Reason: {0}" -f $st.reason)
      Write-Host ("Artifact: {0}" -f $st.artifact_dir)
    }
    break
  }

  "disable" {
    Require-PhysicalPresence
    if (-not $DisableReason -or $DisableReason.Trim() -eq "") { $DisableReason = "user_requested" }

    $disable = [ordered]@{
      clarity = "Clarity Validator"
      action = "DISABLE"
      disabled_minutes = $DisableMinutes
