      reenable_at_utc = (Get-Date).ToUniversalTime().AddMinutes($DisableMinutes).ToString("o")
      mode = "windows_userland_v1_1"
    }
    Write-Text (Join-Path $artifactDir "disable.json") (Json $disable)
    Write-Sha256Sums $artifactDir @("disable.json")

    Set-DisableState -minutes $DisableMinutes -reason $DisableReason -artifactDir $artifactDir
    Write-Host "CLARITY: disabled (time-bounded). Auto re-enables after window." -ForegroundColor Yellow
    Write-Host ("Disable artifact: {0}" -f $artifactDir)
    break
  }

  "enable" {
    Require-PhysicalPresence
    Clear-DisableState
    $enable = [ordered]@{
      clarity = "Clarity Validator"
      action = "ENABLE"
      issued_at_utc = (Get-Date).ToUniversalTime().ToString("o")
      mode = "windows_userland_v1_1"
    }
    Write-Text (Join-Path $artifactDir "enable.json") (Json $enable)
    Write-Sha256Sums $artifactDir @("enable.json")
    Write-Host "CLARITY: enabled." -ForegroundColor Green
    Write-Host ("Enable artifact: {0}" -f $artifactDir)
    break
  }

  "restore" {
    Require-PhysicalPresence
    Write-Host "CLARITY restore:" -ForegroundColor Cyan
    Write-Host "Paste full path to a *.rollback.json file (created by Rename blocking)" -ForegroundColor Yellow
    $rb = Read-Host "Rollback file"
    $res = Restore-FromRollback -rollbackPath $rb
    Write-Host ("Restored: {0}" -f $res.restored) -ForegroundColor Green
    break
  }

  "scan" {
    if (Get-IsDisabled) {
      Write-Host "CLARITY: validator is currently DISABLED (time-bounded). Exiting scan." -ForegroundColor Yellow
      exit 2
    }

    $mode = "windows_userland_v1_1"
    $bootVerification = [ordered]@{
      status = "degraded"
      reason = "BOOT_CHAIN_NOT_AVAILABLE_IN_USERLAND"
    }

    $targets = if ($FullScan) { @($TargetRoot) } else { (Get-TargetsFast -root $TargetRoot -rules $rules) }

    $verified = New-Object System.Collections.Generic.List[object]
    $findings = New-Object System.Collections.Generic.List[object]

    $fileCount = 0
    foreach ($t in $targets) {
      Get-ChildItem -LiteralPath $t -File -Recurse -Force -ErrorAction SilentlyContinue |
        ForEach-Object {
          if ($findings.Count -ge $MaxFindings) { return }
          $fi = $_
          $fileCount++

          $reason = Get-SuspicionReason -fi $fi -rules $rules
          if ($null -ne $reason) {
            # Always copy-to-vault (safe)
            $rec = $null
            try { $rec = Copy-ToVault -src $fi.FullName -vaultDir $vaultDir -reason $reason } catch {
              $findings.Add([ordered]@{ path=$fi.FullName; sha256=""; reason="R_VAULT_COPY_FAILED"; vault_path=""; block_action="none"; block_detail=$_.Exception.Message })
              return
            }

            # Default safe: do NOT modify original.
            $blockAction = "none"
            $blockDetail = ""

            if ($QuarantineMode -eq "CopyAndBlock") {
              $p = $fi.FullName
              $isCritical = Is-UnderPrefix -p $p -prefixes $rules.scan.critical_prefixes
              $isAllowedRoot = Is-UnderPrefix -p $p -prefixes $rules.quarantine.allowed_block_roots

              if ($isCritical) {
                $blockAction = "refused"
                $blockDetail = "REFUSED_CRITICAL_PATH"
              } elseif (-not $isAllowedRoot) {
                $blockAction = "refused"
                $blockDetail = "REFUSED_OUTSIDE_ALLOWED_BLOCK_ROOTS"
              } else {
                if ($BlockMethod -eq "Marker") {
                  $m = Block-OriginalMarker -src $p -reason $reason -runId $runId
                  $blockAction = "marker"
                  $blockDetail = $m
                } elseif ($BlockMethod -eq "Rename") {
                  # Rename allowed ONLY for Startup (very conservative)
                  $pl = $p.ToLowerInvariant()
                  if ($pl -like "*\start menu\programs\startup\*") {
                    $rb = Block-OriginalRename -src $p -reason $reason -runId $runId
                    $blockAction = "rename"
                    $blockDetail = $rb.rollback
                  } else {
                    $blockAction = "refused"
                    $blockDetail = "REFUSED_RENAME_NOT_STARTUP"
                  }
                }
              }
            }

            $findings.Add([ordered]@{
              path = $rec.original
              sha256 = $rec.sha256
              reason = $rec.reason
              vault_path = $rec.vault
              quarantine_mode = $QuarantineMode
