{
  "schema": "clarity.session_event_types.v1",
  "producer": "clarity",
  "types": [
    "clarity.session.created.v1",
    "clarity.session.launch.requested.v1",
    "clarity.session.launch.blocked.v1",
    "clarity.session.started.v1",
    "clarity.session.ended.v1",
    "clarity.session.replayed.v1",
    "clarity.quarantine.object.attached.v1",
    "clarity.quarantine.object.released.v1",
    "clarity.quarantine.object.destroy_requested.v1",
    "clarity.quarantine.object.destroy_completed.v1"
  ],
  "state_machine": {
    "states": [
      "sealed",
      "verified",
      "unverified",
      "quarantined",
      "inspect_only",
      "released",
      "archived",
      "destroy_pending",
      "destroyed"
    ],
    "allowed_transitions": [
      "sealed->inspect_only",
      "sealed->quarantined",
      "verified->inspect_only",
      "verified->released",
      "unverified->quarantined",
      "quarantined->inspect_only",
      "quarantined->destroy_pending",
      "destroy_pending->destroyed",
      "inspect_only->archived",
      "inspect_only->released"
    ]
  }
}
